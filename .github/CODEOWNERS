# Files that guard money, accounts, keys, publishing and the review rules.
# A pull request that changes any of them waits for the operator to merge (REVIEW.md).
# tools/pr_gate.py reads this list, from the base branch and from the pull request.
# It also treats every Edit and Write deny rule in factories/<name>/.claude/settings.json as protected.
# Start every path with /, because the gate matches paths from the repository root only.
/factories/*/budget.yaml            @TirthParikh27
/factories/*/CLAUDE.md              @TirthParikh27
/factories/*/ESCALATION.md          @TirthParikh27
/factories/*/checks/                @TirthParikh27
/factories/*/publish.py             @TirthParikh27
/factories/*/fetch_reviews.py       @TirthParikh27
# Scripts at the top of a factory folder are the ones its runs are allowed to execute.
/factories/*/*.py                   @TirthParikh27
/factories/*/*.js                   @TirthParikh27
/factories/*/*.sh                   @TirthParikh27
/factories/*/.coveragerc            @TirthParikh27
/factories/*/.claude/               @TirthParikh27
/factories/*/.mcp.json              @TirthParikh27
/factories/*/tools/                 @TirthParikh27
# Stop and freeze files: only the operator restarts a factory.
/STOP                               @TirthParikh27
/factories/*/STOP                   @TirthParikh27
/factories/*/state/STOP             @TirthParikh27
/factories/*/state/SUBMISSIONS_FROZEN @TirthParikh27
/factories/*/escalations/approved/  @TirthParikh27
/factories/*/escalations/rejected/  @TirthParikh27
/tools/                             @TirthParikh27
/.github/                           @TirthParikh27
