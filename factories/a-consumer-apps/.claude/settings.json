      "Edit(.claude/**)", "Write(.claude/**)",
      "Edit(escalations/approved/**)", "Write(escalations/approved/**)",
      "Edit(escalations/rejected/**)", "Write(escalations/rejected/**)",
      "Edit(STOP)", "Write(STOP)"
    ]
  }
